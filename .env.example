# Copy this file to ".env" and fill it in. ".env" is git-ignored, never commit it.

# Neon > your project > Connect > copy the connection string (Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# Any long random string. Required on hosted servers.
JWT_SECRET=change-me-to-a-long-random-string

# ---- Contact Us email (pick ONE option; without either, messages are still saved for the admin) ----
# Where messages are delivered
CONTACT_TO=shivambisht7376@gmail.com

# Option A (works on Render free): Resend API key from https://resend.com
# Sign up to Resend with the SAME email as CONTACT_TO. Until you verify a domain, it can only deliver to that address.
RESEND_API_KEY=

# Option B (local PC / paid hosts): Gmail with an App Password
# Google Account > Security > 2-Step Verification > App passwords
SMTP_USER=
SMTP_PASS=
